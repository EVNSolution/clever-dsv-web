{
  "name": "dsv-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSV 전용 웹 프론트엔드 for dsv.cleversystem.ai.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "test:e2e": "VITE_DSV_API_MODE=mock playwright test",
    "test:e2e:remote": "CI=1 VITE_DSV_API_MODE=remote playwright test tests/e2e/remote-v1-boundary.spec.js tests/e2e/remote-tab-parity.spec.js",
    "check": "npm run build && npm run test:e2e && npm run test:e2e:remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "maplibre-gl": "^5.24.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.7"
  }
}
